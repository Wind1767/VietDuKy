{
  "name": "vietduky",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Việt Du Ký",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:all": "npm test && npm run test:e2e",
    "format": "node tools/format.mjs",
    "format:check": "node tools/format.mjs --check",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
